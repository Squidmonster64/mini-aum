{
  "cli": {
    "version": ">= 5.0.0"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal"
    },
    "production": {
      "distribution": "store"
    }
  },
  "submit": {
    "production": {
      "ios": {
        "serviceAccount": "~/path/to/api.json",
        "appleId": "your-apple-id@example.com",
        "appleTeamId": "your-team-id",
        "appleAppSpecificPassword": "your-app-specific-password"
      }
    }
  }
}
